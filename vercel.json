{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate --schema backend/prisma/schema.prisma",
  "outputDirectory": "website",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/src/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/authority",
      "destination": "/authority/index.html"
    },
    {
      "source": "/driver",
      "destination": "/driver/index.html"
    },
    {
      "source": "/passenger",
      "destination": "/passenger/index.html"
    }
  ]
}