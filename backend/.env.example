# FleetSync Backend — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/fleetsync?schema=public"

# ─── JWT ────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret_in_production"
JWT_EXPIRES_IN="24h"

# ─── Server ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── WebSocket ──────────────────────────────────────────────────────
# Staleness threshold for "Last Seen" badge (milliseconds)
LOCATION_STALE_MS=30000
