// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema
//
// Schema v2.0 — aligned with fleetsync_schema.sql (multi-tenant SaaS)
// Tenant isolation: every tenant-owned table carries institution_id.
// Core tables expose UNIQUE (institution_id, id); child tables reference
// them with composite FKs (institution_id, x_id).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis, citext]
}

// =============================================================================
// View 1: Tenancy, Users and Access
// =============================================================================

model Institution {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions         Subscription[]
  users                 User[]
  drivers               Driver[]
  roles                 Role[]
  userRoles             UserRole[]
  vehicleModels         VehicleModel[]
  vehicles              Vehicle[]
  routes                Route[]
  stops                 Stop[]
  routeStops            RouteStop[]
  devices               Device[]
  trips                 Trip[]
  gpsLogs               GpsLog[]
  vehicleLatestPosition VehicleLatestPosition[]
  maintenanceRecords    MaintenanceRecord[]
  fuelLogs              FuelLog[]
  notifications         Notification[]

  @@map("institutions")
}

model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String    @map("institution_id") @db.Uuid
  planName      String    @map("plan_name")
  /// CHECK: trial | active | past_due | cancelled | expired
  status        String    @default("active")
  startDate     DateTime  @default(dbgenerated("current_date")) @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId], name: "idx_subscriptions_institution")
  @@map("subscriptions")
}

/// Platform-level staff. Not tenant-scoped.
model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  /// citext in DB — case-insensitive comparison
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// CHECK: support | admin | super_admin
  adminLevel   String   @default("support") @map("admin_level")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_admins")
}

/// Login identities. Email is globally unique so login can resolve the tenant.
model User {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String
  /// citext in DB — globally unique
  email         String   @unique
  phone         String?
  passwordHash  String   @map("password_hash")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution   Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  driver        Driver?
  userRoles     UserRole[]
  fuelLogs      FuelLog[]
  notifications Notification[]

  /// Composite key required for composite FK references from child tables
  @@unique([institutionId, id], name: "uq_users_tenant")
  @@map("users")
}

/// Employee records. May optionally link to a login user.
model Driver {
  id               String    @id @default(uuid()) @db.Uuid
  institutionId    String    @map("institution_id") @db.Uuid
  /// Links to users.id — also composite FK (institution_id, user_id) → users(institution_id, id)
  userId           String?   @unique @map("user_id") @db.Uuid
  employeeCode     String?   @map("employee_code")
  name             String
  phone            String?
  licenseNumber    String    @map("license_number")
  licenseClass     String?   @map("license_class")
  licenseExpiry    DateTime? @map("license_expiry") @db.Date
  /// CHECK: active | on_leave | suspended | terminated
  employmentStatus String    @default("active") @map("employment_status")
  hiredAt          DateTime? @map("hired_at") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  /// Composite FK via raw SQL trigger — Prisma uses simple FK here
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicles    Vehicle[]
  trips       Trip[]

  @@unique([institutionId, id], name: "uq_drivers_tenant")
  @@unique([institutionId, licenseNumber], name: "uq_drivers_license")
  @@map("drivers")
}

model Role {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String
  description   String?
  /// Seeded roles that tenants cannot delete
  isSystem      Boolean  @default(false) @map("is_system")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([institutionId, id], name: "uq_roles_tenant")
  @@unique([institutionId, name], name: "uq_roles_name")
  @@map("roles")
}

/// Global permission catalog (shared by all tenants).
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  /// e.g. 'vehicles.read', 'trips.manage'
  code        String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId        String   @map("user_id") @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  assignedAt    DateTime @default(now()) @map("assigned_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId], name: "idx_user_roles_role")
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId], name: "idx_role_permissions_permission")
  @@map("role_permissions")
}

// =============================================================================
// View 2: Fleet and Assignments
// =============================================================================

/// institution_id IS NULL → global platform catalog entry.
model VehicleModel {
  id            String  @id @default(uuid()) @db.Uuid
  institutionId String? @map("institution_id") @db.Uuid
  make          String
  model         String
  year          Int?
  fuelType      String? @map("fuel_type")
  capacity      Int?

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicles    Vehicle[]

  @@index([institutionId], name: "idx_vehicle_models_institution")
  @@map("vehicle_models")
}

model Route {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicles    Vehicle[]
  routeStops  RouteStop[]
  trips       Trip[]

  @@unique([institutionId, id], name: "uq_routes_tenant")
  @@unique([institutionId, name], name: "uq_routes_name")
  @@map("routes")
}

model Stop {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  name          String
  latitude      Float
  longitude     Float
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  routeStops  RouteStop[]

  @@unique([institutionId, id], name: "uq_stops_tenant")
  @@map("stops")
}

model RouteStop {
  routeId       String @map("route_id") @db.Uuid
  stopId        String @map("stop_id") @db.Uuid
  institutionId String @map("institution_id") @db.Uuid
  stopOrder     Int    @map("stop_order")

  route       Route       @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop        Stop        @relation(fields: [stopId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([routeId, stopId])
  @@unique([routeId, stopOrder], name: "uq_route_stops_order")
  @@index([stopId], name: "idx_route_stops_stop")
  @@map("route_stops")
}

/// Driver and route assignment is optional (ride-hailing / on-demand workflows).
model Vehicle {
  id               String   @id @default(uuid()) @db.Uuid
  institutionId    String   @map("institution_id") @db.Uuid
  modelId          String   @map("model_id") @db.Uuid
  assignedDriverId String?  @map("assigned_driver_id") @db.Uuid
  assignedRouteId  String?  @map("assigned_route_id") @db.Uuid
  vehicleNumber    String   @map("vehicle_number")
  plateNumber      String   @map("plate_number")
  /// CHECK: idle | on_trip | maintenance | offline | retired
  currentStatus    String   @default("idle") @map("current_status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  institution        Institution            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  model              VehicleModel           @relation(fields: [modelId], references: [id])
  assignedDriver     Driver?                @relation(fields: [institutionId, assignedDriverId], references: [institutionId, id], onDelete: SetNull)
  assignedRoute      Route?                 @relation(fields: [institutionId, assignedRouteId], references: [institutionId, id], onDelete: SetNull)
  devices            Device[]
  trips              Trip[]
  gpsLogs            GpsLog[]
  latestPosition     VehicleLatestPosition?
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  @@unique([institutionId, id], name: "uq_vehicles_tenant")
  @@unique([institutionId, vehicleNumber], name: "uq_vehicles_number")
  @@unique([institutionId, plateNumber], name: "uq_vehicles_plate")
  @@index([modelId], name: "idx_vehicles_model")
  @@map("vehicles")
}

// =============================================================================
// View 3: Tracking and Trips
// =============================================================================

model Device {
  id              String    @id @default(uuid()) @db.Uuid
  institutionId   String    @map("institution_id") @db.Uuid
  vehicleId       String    @map("vehicle_id") @db.Uuid
  deviceType      String    @map("device_type")
  /// Physically unique across the platform
  imei            String    @unique
  simIccid        String?   @map("sim_iccid")
  firmwareVersion String?   @map("firmware_version")
  /// CHECK: active | inactive | faulty | retired
  status          String    @default("active")
  installedAt     DateTime? @map("installed_at")
  lastSeenAt      DateTime? @map("last_seen_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  institution     Institution             @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicle         Vehicle                 @relation(fields: [institutionId, vehicleId], references: [institutionId, id])
  gpsLogs         GpsLog[]
  latestPositions VehicleLatestPosition[]

  @@unique([institutionId, id], name: "uq_devices_tenant")
  @@index([vehicleId], name: "idx_devices_vehicle")
  @@map("devices")
}

model Trip {
  id            String    @id @default(uuid()) @db.Uuid
  institutionId String    @map("institution_id") @db.Uuid
  vehicleId     String    @map("vehicle_id") @db.Uuid
  driverId      String    @map("driver_id") @db.Uuid
  routeId       String?   @map("route_id") @db.Uuid
  /// CHECK: scheduled | in_progress | completed | cancelled
  status        String    @default("in_progress")
  startedAt     DateTime  @default(now()) @map("started_at")
  endedAt       DateTime? @map("ended_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [institutionId, vehicleId], references: [institutionId, id])
  driver      Driver      @relation(fields: [institutionId, driverId], references: [institutionId, id])
  route       Route?      @relation(fields: [institutionId, routeId], references: [institutionId, id], onDelete: SetNull)

  gpsLogs        GpsLog[]
  /// A trip may have a live position tracked on the vehicle_latest_position table
  latestPositions VehicleLatestPosition[]

  @@unique([institutionId, id], name: "uq_trips_tenant")
  @@index([vehicleId], name: "idx_trips_vehicle_started")
  @@index([driverId], name: "idx_trips_driver_started")
  @@map("trips")
}

/// Raw telemetry — partitioned by month on recorded_at in the actual SQL.
/// Prisma manages it as a regular table; partitioning is handled via raw SQL.
model GpsLog {
  id            BigInt   @default(autoincrement())
  recordedAt    DateTime @map("recorded_at")
  institutionId String   @map("institution_id") @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  tripId        String?  @map("trip_id") @db.Uuid
  /// PostGIS geography(Point, 4326) — stored natively; read via raw SQL
  location      Unsupported("geography(Point, 4326)")
  accuracy      Float?
  speed         Float?
  heading       Float?
  ignitionOn    Boolean? @map("ignition_on")
  receivedAt    DateTime @default(now()) @map("received_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [institutionId, vehicleId], references: [institutionId, id])
  device      Device      @relation(fields: [institutionId, deviceId], references: [institutionId, id])
  trip        Trip?       @relation(fields: [institutionId, tripId], references: [institutionId, id])

  @@id([id, recordedAt])
  @@index([vehicleId], name: "idx_gps_logs_vehicle_time")
  @@map("gps_logs")
}

/// Live map state: exactly one row per vehicle, upserted on every ping.
model VehicleLatestPosition {
  vehicleId     String   @id @map("vehicle_id") @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  deviceId      String   @map("device_id") @db.Uuid
  /// nullable — vehicle may be between trips
  tripId        String?  @map("trip_id") @db.Uuid
  /// PostGIS geography(Point, 4326)
  location      Unsupported("geography(Point, 4326)")
  speed         Float?
  heading       Float?
  ignitionOn    Boolean? @map("ignition_on")
  recordedAt    DateTime @map("recorded_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vehicle     Vehicle     @relation(fields: [institutionId, vehicleId], references: [institutionId, id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  device      Device      @relation(fields: [institutionId, deviceId], references: [institutionId, id])
  /// One-to-many: tripId points to the active trip for this vehicle's current live state
  trip        Trip?       @relation(fields: [tripId], references: [id])

  @@unique([institutionId, vehicleId])
  @@index([institutionId], name: "idx_vlp_institution")
  @@map("vehicle_latest_position")
}

// =============================================================================
// View 4: Maintenance, Fuel and Notifications
// =============================================================================

model MaintenanceRecord {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  vehicleId     String   @map("vehicle_id") @db.Uuid
  description   String
  /// Nullable — cost may not be known at schedule time
  cost          Decimal? @db.Decimal(12, 2)
  serviceDate   DateTime @map("service_date") @db.Date
  /// CHECK: scheduled | in_progress | completed | cancelled
  status        String   @default("scheduled")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicle     Vehicle     @relation(fields: [institutionId, vehicleId], references: [institutionId, id], onDelete: Cascade)

  @@index([vehicleId], name: "idx_maintenance_vehicle_date")
  @@map("maintenance_records")
}

model FuelLog {
  id             String   @id @default(uuid()) @db.Uuid
  institutionId  String   @map("institution_id") @db.Uuid
  vehicleId      String   @map("vehicle_id") @db.Uuid
  /// NOT NULL — every fuel log must have a logger
  loggedByUserId String   @map("logged_by_user_id") @db.Uuid
  volume         Decimal  @db.Decimal(10, 2)
  totalCost      Decimal  @map("total_cost") @db.Decimal(12, 2)
  logDate        DateTime @default(dbgenerated("current_date")) @map("log_date") @db.Date

  institution  Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicle      Vehicle     @relation(fields: [institutionId, vehicleId], references: [institutionId, id], onDelete: Cascade)
  loggedByUser User        @relation(fields: [institutionId, loggedByUserId], references: [institutionId, id])

  @@index([vehicleId], name: "idx_fuel_vehicle_date")
  @@index([loggedByUserId], name: "idx_fuel_user")
  @@map("fuel_logs")
}

model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  institutionId String   @map("institution_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  title         String
  message       String
  isRead        Boolean  @default(false) @map("is_read")
  createdAt     DateTime @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [institutionId, userId], references: [institutionId, id], onDelete: Cascade)

  @@index([userId], name: "idx_notifications_user_unread")
  @@map("notifications")
}
