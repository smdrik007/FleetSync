#!/bin/sh
# Pre-commit hook to verify committer identity

AUTHOR_EMAIL=$(git config user.email)

if [ "$AUTHOR_EMAIL" = "mushfiq.shafi13@gmail.com" ] || [ -z "$AUTHOR_EMAIL" ]; then
    echo "===================================================================="
    echo "ERROR: Invalid Git author email configured: '$AUTHOR_EMAIL'"
    echo "To fix, configure your Git email to your team/GitHub account:"
    echo "  git config user.name \"Your Name\""
    echo "  git config user.email \"your-github-email@example.com\""
    echo "===================================================================="
    exit 1
fi

exit 0
